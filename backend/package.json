{
  "name": "backend",
  "version": "1.0.0",
  "description": "PROTECTHER Audit Panel - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node src/database/migrate.ts",
    "migrate:projects": "ts-node src/database/migrations/002-add-projects.ts",
    "migrate:reset-token": "ts-node src/database/migrations/003-add-password-reset.ts",
    "migrate:history": "ts-node src/database/migrations/add-audit-response-history.ts",
    "migrate:password-changed": "ts-node src/database/migrations/004-add-password-changed-at.ts",
    "migrate:indexes": "ts-node src/database/migrations/005-add-indexes-constraints.ts",
    "migrate:removed-status": "ts-node src/database/migrations/006-add-removed-status.ts",
    "migrate:custom-items": "ts-node src/database/migrations/007-add-custom-audit-items.ts",
    "migrate:patches": "npm run migrate:projects && npm run migrate:reset-token && npm run migrate:history && npm run migrate:password-changed && npm run migrate:indexes && npm run migrate:removed-status && npm run migrate:custom-items",
    "seed": "ts-node src/database/seed.ts",
    "cleanup": "ts-node src/database/cleanup-duplicates.ts",
    "backup": "ts-node src/database/backup.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "dotenv": "^16.3.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.2",
    "pg": "^8.11.3",
    "sharp": "^0.35.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
